{
  "manifest_version": 3,
  "name": "Claudette",
  "version": "6.2.2",
  "description": "Export Claude.ai chats as Markdown or plain text with images.",
  "permissions": [
    "storage",
    "downloads",
    "webRequest",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["stt_patch.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "jszip.min.js",
        "image_classifier.js",
        "exporter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ocr_engine.html",
        "ocr_engine.js",
        "tesseract.min.js",
        "worker.min.js",
        "worker-overwrites.js",
        "tesseract-core-simd-lstm.wasm.js",
        "tesseract-core-simd-lstm.wasm",
        "tesseract-core-simd-lstm.js",
        "exporter.js",
        "jszip.min.js",
        "image_classifier.js",
        "stt_patch.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  }
}